<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_signals">
    <target android:name="bar1">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="0" android:duration="350"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="120" android:duration="350"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="240" android:duration="350"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
</animated-vector>
